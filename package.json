{
  "name": "openai-sql-weknow",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "migrate:build": "node dist/migrate.js",
    "build:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:server": "esbuild src/server.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/server.js --sourcemap",
    "build:migrate": "esbuild src/migrate.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/migrate.js --sourcemap",
    "build:assets": "node scripts/copy-migrations.mjs",
    "build": "npm run build:clean && npm run build:server && npm run build:migrate && npm run build:assets",
    "type-check": "tsc --noEmit",
    "start-sample-msg": "tsx src/index.ts -m \"listar todos os campos da tabela\"",
    "test": "vitest"
  },
  "author": "Leonel Thiesen",
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "body-parser": "^2.2.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "node-fetch": "^3.3.2",
    "node-html-parser": "^7.1.0",
    "openai": "^6.16.0",
    "postgres": "^3.4.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@types/body-parser": "^1.19.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.0",
    "eslint": "^9.5.0",
    "globals": "^17.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  }
}
